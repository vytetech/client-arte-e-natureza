# Backend
# SESSION_SECRET: obrigatoria em producao. Opcional em desenvolvimento; sem valor, usa segredo local temporario.
SESSION_SECRET=

# Database
# DATABASE_URL: obrigatoria em producao e para area admin/persistencia.
# Opcional em desenvolvimento para paginas publicas, que usam conteudo padrao quando ausente.
# Formato Render/PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Runtime
# PORT: opcional. Usada somente em producao/start; padrao 3000.
PORT=3000

# Bootstrap do primeiro administrador
# Usadas somente ao executar npm run admin:create.
# Remova/desative depois do primeiro acesso.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=
