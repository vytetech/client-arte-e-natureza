# Backend
# APP_SECRET: obrigatoria em producao. Opcional em desenvolvimento; sem valor, usa segredo local temporario.
APP_SECRET=

# APP_ID: obrigatoria somente para OAuth Kimi. Opcional para login local em desenvolvimento.
APP_ID=

# Database
# DATABASE_URL: obrigatoria em producao e para area admin/persistencia.
# Opcional em desenvolvimento para paginas publicas, que usam conteudo padrao quando ausente.
# Formato: mysql://user:password@host:port/database
DATABASE_URL=

# Kimi OAuth / Open Platform
# Opcionais. Se usar Kimi, configure todas: APP_ID, APP_SECRET, KIMI_AUTH_URL, KIMI_OPEN_URL,
# VITE_APP_ID e VITE_KIMI_AUTH_URL.
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# Frontend publico via Vite
# Opcionais. Habilitam o botao "Entrar com Kimi" no navegador.
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# Admin
# OWNER_UNION_ID: opcional. Define qual usuario OAuth Kimi recebe papel admin no primeiro login.
OWNER_UNION_ID=

# Runtime
# PORT: opcional. Usada somente em producao/start; padrao 3000.
PORT=3000
